SECRET_KEY=change_me_to_a_strong_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Kamadhenu
VERSION=0.1.0
DEBUG=true
