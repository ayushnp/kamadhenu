# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ─── JWT ─────────────────────────────────────────────────────────────────────
